{
  "greetings": {
    "name": "👋 Приветствия и прощания",
    "phrases": [
      {
        "english": "Hello! / Hi!",
        "russian": "Привет!",
        "context": "Неформальное приветствие",
        "examples": ["Hello! My name is Anna", "Hi! How are you?"]
      },
      {
        "english": "Good morning!",
        "russian": "Доброе утро!",
        "context": "До 12:00",
        "examples": ["Good morning! Did you sleep well?"]
      },
      {
        "english": "Good afternoon!",
        "russian": "Добрый день!",
        "context": "12:00-18:00",
        "examples": ["Good afternoon! How can I help you?"]
      },
      {
        "english": "Good evening!",
        "russian": "Добрый вечер!",
        "context": "После 18:00",
        "examples": ["Good evening! Nice to see you"]
      },
      {
        "english": "How are you?",
        "russian": "Как дела?",
        "context": "Стандартный вопрос",
        "examples": ["Hi! How are you?", "How are you today?"]
      },
      {
        "english": "I'm fine, thanks!",
        "russian": "Хорошо, спасибо!",
        "context": "Позитивный ответ",
        "examples": ["I'm fine, thanks! And you?"]
      }
    ]
  },
  "introduction": {
    "name": "🤝 Знакомство",
    "phrases": [
      {
        "english": "What's your name?",
        "russian": "Как тебя зовут?",
        "context": "Спросить имя",
        "examples": ["Hello! What's your name?"]
      },
      {
        "english": "My name is...",
        "russian": "Меня зовут...",
        "context": "Представиться",
        "examples": ["My name is Alex", "Hi! My name is Maria"]
      },
      {
        "english": "Where are you from?",
        "russian": "Откуда ты?",
        "context": "Спросить откуда",
        "examples": ["Where are you from?", "I'm from Russia. Where are you from?"]
      },
      {
        "english": "I'm from Russia",
        "russian": "Я из России",
        "context": "Ответить откуда",
        "examples": ["I'm from Russia", "She is from Russia"]
      },
      {
        "english": "Nice to meet you!",
        "russian": "Приятно познакомиться!",
        "context": "После знакомства",
        "examples": ["Nice to meet you!", "It's nice to meet you"]
      }
    ]
  },
  "cafe": {
    "name": "☕ В кафе и ресторане",
    "phrases": [
      {
        "english": "Can I have a coffee?",
        "russian": "Можно мне кофе?",
        "context": "Заказ напитка",
        "examples": ["Can I have a coffee, please?"]
      },
      {
        "english": "I would like tea",
        "russian": "Я бы хотел(а) чай",
        "context": "Вежливый заказ",
        "examples": ["I would like tea with milk"]
      },
      {
        "english": "What do you recommend?",
        "russian": "Что вы посоветуете?",
        "context": "Спросить рекомендацию",
        "examples": ["What do you recommend for dessert?"]
      },
      {
        "english": "How much is it?",
        "russian": "Сколько это стоит?",
        "context": "Узнать цену",
        "examples": ["How much is this coffee?"]
      },
      {
        "english": "The bill, please",
        "russian": "Счет, пожалуйста",
        "context": "Попросить счет",
        "examples": ["The bill, please", "Can I have the bill?"]
      }
    ]
  },
  "questions": {
    "name": "❓ Основные вопросы",
    "phrases": [
      {
        "english": "What is this?",
        "russian": "Что это?",
        "context": "Спросить о предмете",
        "examples": ["What is this? It looks interesting"]
      },
      {
        "english": "Where is...?",
        "russian": "Где...?",
        "context": "Спросить о месте",
        "examples": ["Where is the station?", "Where is your house?"]
      },
      {
        "english": "When...?",
        "russian": "Когда...?",
        "context": "Спросить о времени",
        "examples": ["When does the shop open?", "When are you coming?"]
      },
      {
        "english": "Why...?",
        "russian": "Почему...?",
        "context": "Спросить причину",
        "examples": ["Why are you late?", "Why is it expensive?"]
      },
      {
        "english": "How...?",
        "russian": "Как...?",
        "context": "Спросить способ",
        "examples": ["How do you cook this?", "How can I help you?"]
      }
    ]
  }
}
